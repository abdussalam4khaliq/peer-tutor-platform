# Copy this file to .env.local and fill in the real values.
# The same variables must be set in Vercel (Project Settings > Environment Variables).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://virtualcoursemate.com.ng

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_ENABLED=true

# --- Web push notifications ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
PUSH_WEBHOOK_SECRET=a-long-random-string

# --- PostHog analytics ---
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
